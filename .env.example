# App
APP_NAME=SentinelOps
VERSION=0.2.0
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Security / Auth
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CENTRAL_AUTH_URL=https://auth.example.com/api/gateway/user-service/login
FRONTEND_URL=https://sentinelops.example.com
CORS_ORIGINS=https://sentinelops.example.com

# External dashboard telemetry
DASHBOARD_WEEKLY_ENDPOINT=https://telemetry.example.com/api/dashboard/weekly
DASHBOARD_PREDICTION_ENDPOINT=https://telemetry.example.com/api/dashboard/prediction

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=alerts@example.com
SMTP_USE_TLS=false
SMTP_STARTTLS=true

# Oracle / IDC
ORACLE_USER=oracle-user
ORACLE_PASSWORD=oracle-password
IDC_ORACLE_HOST=oracle-host
ORACLE_PORT=1521
ORACLE_SID=oracle-sid
# ORACLE_DSN=
# ORACLE_SERVICE_NAME=

# Digipay Postgres
DIGIPAY_DATABASE_URL=postgresql://user:password@host:5432/database
# DIGIPAY_PG_USER=
# DIGIPAY_PG_PASSWORD=
# DIGIPAY_PG_HOST=
# DIGIPAY_PG_PORT=5432
# DIGIPAY_PG_DATABASE=

# Bootstrap script
BOOTSTRAP_USERNAME=sentinel-user
BOOTSTRAP_EMAIL=user@example.com
BOOTSTRAP_FIRST_NAME=First
BOOTSTRAP_LAST_NAME=Last
BOOTSTRAP_USER_PASSWORD=replace-with-temporary-password
BOOTSTRAP_ROLE=user
